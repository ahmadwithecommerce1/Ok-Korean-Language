# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ELEVENLABS TEXT-TO-SPEECH (TTS) CONFIGURATION:
# Provide your ElevenLabs API key from https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# Voice ID (Default is Sarah voice ID: EXAVITQu4vr4xnSDxMaL or your preferred Korean voice ID)
VITE_ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
